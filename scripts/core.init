#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -x /tmp/mihomo ] || return 1
    [ -s /data/codex-router/config.json ] || return 1
    procd_open_instance
    procd_set_param command /bin/sh /data/codex-router/run-core.sh
    procd_set_param respawn 3600 3 5
    procd_close_instance
}

+++ b/common/udpreply/packet_test.go
@@ -0,0 +1,50 @@
+package udpreply
+
+import (
+	"encoding/hex"
+	"net/netip"
+	"testing"
+)
+
+func TestUDPReplyPacketGoldenChecksums(t *testing.T) {
+	for _, test := range []struct{ server, client, want string }{
+		{"127.0.0.2:27051", "127.0.0.1:40000", "69ab9c4000107e646373322d74657374"},
+		{"[2001:db8::2]:27051", "[2001:db8::1]:40000", "69ab9c40001020f36373322d74657374"},
+	} {
+		p, err := buildPacket(netip.MustParseAddrPort(test.server), netip.MustParseAddrPort(test.client), []byte("cs2-test"))
+		if err != nil || hex.EncodeToString(p) != test.want {
+			t.Fatalf("%s packet=%x err=%v", test.server, p, err)
+		}
+	}
+}
+func TestUDPReplyRejectsMixedFamilyAndOversizedPayload(t *testing.T) {
+	a := netip.MustParseAddrPort("127.0.0.2:27051")
+	b := netip.MustParseAddrPort("[::1]:40000")
+	if _, err := buildPacket(a, b, nil); err == nil {
+		t.Fatal("mixed address families accepted")
+	}
+	for _, tc := range []struct {
+		s, c string
+		max  int
+	}{{"127.0.0.2:27051", "127.0.0.1:40000", 65507}, {"[::1]:27051", "[::1]:40000", 65527}} {
+		s, c := netip.MustParseAddrPort(tc.s), netip.MustParseAddrPort(tc.c)
+		if _, err := buildPacket(s, c, make([]byte, tc.max)); err != nil {
+			t.Fatal("legal payload rejected")
+		}
+		if _, err := buildPacket(s, c, make([]byte, tc.max+1)); err == nil {
+			t.Fatal("oversized payload accepted")
+		}
+	}
+}
+func TestOddLengthPayloadAndMappedIPv4(t *testing.T) {
+	for _, tc := range []struct{ s, c, want string }{
+		{"127.0.0.2:27051", "127.0.0.1:40000", "69ab9c40000b3786616263"},
+		{"[::ffff:127.0.0.2]:27051", "127.0.0.1:40000", "69ab9c40000b3786616263"},
+		{"[2001:db8::2]:27051", "[2001:db8::1]:40000", "69ab9c40000bda14616263"},
+	} {
+		got, err := buildPacket(netip.MustParseAddrPort(tc.s), netip.MustParseAddrPort(tc.c), []byte("abc"))
+		if err != nil || hex.EncodeToString(got) != tc.want {
+			t.Fatalf("odd/mapped checksum %x %v", got, err)
+		}
+	}
+}

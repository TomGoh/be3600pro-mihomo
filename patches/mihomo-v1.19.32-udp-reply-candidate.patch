new file mode 100644
index 0000000..69a6995
--- /dev/null
+++ b/listener/tproxy/packet_linux_test.go
@@ -0,0 +1,57 @@
+//go:build linux && udp_integration
+
+package tproxy
+
+import (
+	"fmt"
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/nat"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestWriteBackDeliversWithAndWithoutPortCollision(t *testing.T) {
+	for _, network := range []string{"udp4", "udp6"} {
+		for _, collision := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/collision-%v", network, collision), func(t *testing.T) {
+				clientIP, serverIP, wildcard := "127.0.0.1", "127.0.0.2", "0.0.0.0"
+				if network == "udp6" {
+					clientIP, serverIP, wildcard = "::1", "::1", "::"
+				}
+				client, err := net.ListenUDP(network, &net.UDPAddr{IP: net.ParseIP(clientIP)})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer client.Close()
+				held, err := net.ListenUDP(network, &net.UDPAddr{IP: net.ParseIP(wildcard)})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer held.Close()
+				source := netip.AddrPortFrom(netip.MustParseAddr(serverIP), uint16(held.LocalAddr().(*net.UDPAddr).Port))
+				if !collision {
+					held.Close()
+				}
+				target := client.LocalAddr().(*net.UDPAddr).AddrPort()
+				tunnel := failureTunnel{table: nat.New()}
+				tunnel.table.GetOrCreate(target.String(), func() C.PacketSender { return nil })
+				defer tunnel.table.RangeForLocalConn(target.String(), func(_ string, c *net.UDPConn) bool { c.Close(); return true })
+				p := packet{lAddr: target, tunnel: tunnel}
+				payload := []byte("mihomo WriteBack must preserve UDP data and source")
+				n, err := p.WriteBack(payload, net.UDPAddrFromAddrPort(source))
+				if err != nil || n != len(payload) {
+					t.Fatalf("WriteBack n=%d err=%v", n, err)
+				}
+				_ = client.SetReadDeadline(time.Now().Add(2 * time.Second))
+				buffer := make([]byte, 256)
+				n, from, err := client.ReadFromUDPAddrPort(buffer)
+				if err != nil || from != source || string(buffer[:n]) != string(payload) {
+					t.Fatalf("source=%s n=%d err=%v", from, n, err)
+				}
+			})
+		}
+	}
+}

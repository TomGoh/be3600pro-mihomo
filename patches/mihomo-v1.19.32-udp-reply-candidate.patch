+//go:build linux && udp_matrix
+
+package udpreply
+
+import (
+	"net/netip"
+	"os"
+	"testing"
+)
+
+func TestNonlocalPayloadSizeMatrix(t *testing.T) {
+	for _, tc := range []struct{ family, env, server string }{{"udp4", "UDP_REPLY_PEER4", "192.0.2.6:27051"}, {"udp6", "UDP_REPLY_PEER6", "[2001:db8:7::9]:27052"}} {
+		client, err := netip.ParseAddrPort(os.Getenv(tc.env))
+		if err != nil {
+			t.Fatal(err)
+		}
+		server := netip.MustParseAddrPort(tc.server)
+		for _, size := range []int{0, 1, 3, 64, 1200, 1400, 4096, 32768} {
+			payload := make([]byte, size)
+			for i := range payload {
+				payload[i] = byte((i*31 + int(tc.family[3]-'0')) % 251)
+			}
+			n, e := WritePacket(server, client, payload)
+			if e != nil || n != len(payload) {
+				t.Errorf("%s size%d n%d error%v", tc.family, size, n, e)
+			}
+		}
+	}
+}
diff --git a/common/udpreply/packet.go b/common/udpreply/packet.go
new file mode 100644
index 0000000..900be65
--- /dev/null
+++ b/common/udpreply/packet.go
@@ -0,0 +1,48 @@
+package udpreply
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+)
+
+func buildPacket(server, client netip.AddrPort, payload []byte) ([]byte, error) {
+	src, dst := server.Addr().Unmap(), client.Addr().Unmap()
+	if !src.IsValid() || !dst.IsValid() || src.Is4() != dst.Is4() {
+		return nil, errors.New("UDP reply address families differ")
+	}
+	max := 65527
+	if src.Is4() {
+		max = 65507
+	}
+	if len(payload) > max {
+		return nil, errors.New("UDP reply exceeds IP packet limit")
+	}
+	packet := make([]byte, 8+len(payload))
+	binary.BigEndian.PutUint16(packet[0:2], server.Port())
+	binary.BigEndian.PutUint16(packet[2:4], client.Port())
+	binary.BigEndian.PutUint16(packet[4:6], uint16(len(packet)))
+	copy(packet[8:], payload)
+	sum := uint32(len(packet)) + 17
+	sum += wordSum(src.AsSlice()) + wordSum(dst.AsSlice()) + wordSum(packet)
+	for sum>>16 != 0 {
+		sum = (sum & 0xffff) + (sum >> 16)
+	}
+	checksum := ^uint16(sum)
+	if checksum == 0 {
+		checksum = 0xffff
+	}
+	binary.BigEndian.PutUint16(packet[6:8], checksum)
+	return packet, nil
+}
+func wordSum(data []byte) uint32 {
+	var sum uint32
+	for len(data) >= 2 {
+		sum += uint32(binary.BigEndian.Uint16(data))
+		data = data[2:]
+	}
+	if len(data) == 1 {
+		sum += uint32(data[0]) << 8
+	}
+	return sum
+}
diff --git a/common/udpreply/packet_test.go b/common/udpreply/packet_test.go

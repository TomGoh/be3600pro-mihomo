@@ -0,0 +1,51 @@
+//go:build linux && udp_integration
+
+package udpreply
+
+import (
+	"errors"
+	"net"
+	"net/netip"
+	"os"
+	"syscall"
+	"testing"
+)
+
+func TestRawReplyNonlocalPeer(t *testing.T) {
+	for _, tc := range []struct{ network, env, server string }{{"udp4", "UDP_REPLY_PEER4", "192.0.2.6:27051"}, {"udp6", "UDP_REPLY_PEER6", "[2001:db8:7::9]:27052"}} {
+		t.Run(tc.network, func(t *testing.T) {
+			client, err := netip.ParseAddrPort(os.Getenv(tc.env))
+			if err != nil {
+				t.Fatalf("mandatory isolated peer missing: %s", tc.env)
+			}
+			server := netip.MustParseAddrPort(tc.server)
+			addresses, err := net.InterfaceAddrs()
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, address := range addresses {
+				prefix, e := netip.ParsePrefix(address.String())
+				if e == nil && prefix.Addr().Unmap() == server.Addr() {
+					t.Fatal("server source is local; nonlocal-source test invalid")
+				}
+			}
+			wildcard := net.IPv4zero
+			if tc.network == "udp6" {
+				wildcard = net.IPv6unspecified
+			}
+			blocker, err := net.ListenUDP(tc.network, &net.UDPAddr{IP: wildcard, Port: int(server.Port())})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer blocker.Close()
+			if err = stockBind(server); !errors.Is(err, syscall.EADDRINUSE) {
+				t.Fatalf("forced conflict not established: %v", err)
+			}
+			payload := []byte("mihomo-nonlocal-" + tc.network + "-proof")
+			n, err := WritePacket(server, client, payload)
+			if err != nil || n != len(payload) {
+				t.Fatalf("raw nonlocal send n=%d err=%v", n, err)
+			}
+		})
+	}
+}
diff --git a/common/udpreply/raw_linux.go b/common/udpreply/raw_linux.go
new file mode 100644
index 0000000..e427575
--- /dev/null
+++ b/common/udpreply/raw_linux.go
@@ -0,0 +1,89 @@
+//go:build linux
+
+package udpreply
+
+import (
+	"fmt"
+	"net"
+	"net/netip"
+	"strconv"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// WritePacket sends one UDP reply without claiming a UDP port. A temporary raw
+// socket deliberately avoids port-reuse ambiguity with unrelated UDP sessions.
+// Call only for an EADDRINUSE failure in the normal transparent reply path.
+func WritePacket(server, client netip.AddrPort, payload []byte) (int, error) {
+	packet, err := buildPacket(server, client, payload)
+	if err != nil {
+		return 0, err
+	}
+	src, dst := server.Addr().Unmap(), client.Addr().Unmap()
+	family := syscall.AF_INET6
+	if src.Is4() {
+		family = syscall.AF_INET
+	}
+	fd, err := syscall.Socket(family, syscall.SOCK_RAW|syscall.SOCK_CLOEXEC, syscall.IPPROTO_UDP)
+	if err != nil {
+		return 0, fmt.Errorf("UDP raw reply socket: %w", err)
+	}
+	defer syscall.Close(fd)
+	var local, remote syscall.Sockaddr
+	if src.Is4() {
+		err = syscall.SetsockoptInt(fd, syscall.SOL_IP, syscall.IP_TRANSPARENT, 1)
+		if err != nil {
+			return 0, fmt.Errorf("UDP raw reply transparency: %w", err)
+		}
+		remote = &syscall.SockaddrInet4{Addr: dst.As4()}
+		// Linux 5.4 raw_bind rejects nonlocal IPv4 addresses even with
+		// IP_TRANSPARENT. Supply the source per message instead; the kernel
+		// still constructs the IP header and handles fragmentation normally.
+		control := unix.PktInfo4(&unix.Inet4Pktinfo{Spec_dst: src.As4()})
+		n, e := syscall.SendmsgN(fd, packet, control, remote, 0)
+		if e != nil {
+			return 0, fmt.Errorf("UDP raw reply sendmsg: %w", e)
+		}
+		if n != len(packet) {
+			return 0, fmt.Errorf("UDP raw reply short send: %d/%d", n, len(packet))
+		}
+		return len(payload), nil
+	} else {
+		err = syscall.SetsockoptInt(fd, syscall.SOL_IPV6, 0x4b, 1) // IPV6_TRANSPARENT
+		sourceZone, e := zoneID(src.Zone())
+		if e != nil {
+			return 0, e
+		}
+		destZone, e := zoneID(dst.Zone())
+		if e != nil {
+			return 0, e
+		}
+		local = &syscall.SockaddrInet6{Addr: src.As16(), ZoneId: sourceZone}
+		remote = &syscall.SockaddrInet6{Addr: dst.As16(), ZoneId: destZone}
+	}
+	if err != nil {
+		return 0, fmt.Errorf("UDP raw reply transparency: %w", err)
+	}
+	if err = syscall.Bind(fd, local); err != nil {
+		return 0, fmt.Errorf("UDP raw reply source bind: %w", err)
+	}
+	if err = syscall.Sendto(fd, packet, 0, remote); err != nil {
+		return 0, fmt.Errorf("UDP raw reply send: %w", err)
+	}
+	return len(payload), nil
+}
+
+func zoneID(zone string) (uint32, error) {
+	if zone == "" {
+		return 0, nil
+	}
+	if value, err := strconv.ParseUint(zone, 10, 32); err == nil {
+		return uint32(value), nil
+	}
+	nic, err := net.InterfaceByName(zone)
+	if err != nil {
+		return 0, fmt.Errorf("UDP raw reply IPv6 zone: %w", err)
+	}
+	return uint32(nic.Index), nil
+}
diff --git a/common/udpreply/raw_linux_test.go b/common/udpreply/raw_linux_test.go
new file mode 100644
index 0000000..c65e6c5
--- /dev/null
+++ b/common/udpreply/raw_linux_test.go
@@ -0,0 +1,115 @@
+//go:build linux && udp_integration
+
+package udpreply
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Run in an isolated Linux network namespace with CAP_NET_RAW. Never skip a
+// missing capability: a green result must mean real IP/UDP delivery occurred.
+func collisionFixture(t *testing.T, network string) (*net.UDPConn, *net.UDPConn, netip.AddrPort) {
+	t.Helper()
+	wildcard, source, client := "0.0.0.0", "127.0.0.2", "127.0.0.1"
+	if network == "udp6" {
+		wildcard, source, client = "::", "::1", "::1"
+	}
+	blocker, err := net.ListenUDP(network, &net.UDPAddr{IP: net.ParseIP(wildcard)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { blocker.Close() })
+	receiver, err := net.ListenUDP(network, &net.UDPAddr{IP: net.ParseIP(client)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { receiver.Close() })
+	return blocker, receiver, netip.AddrPortFrom(netip.MustParseAddr(source), uint16(blocker.LocalAddr().(*net.UDPAddr).Port))
+}
+func stockBind(server netip.AddrPort) error {
+	family := syscall.AF_INET6
+	if server.Addr().Is4() {
+		family = syscall.AF_INET
+	}
+	fd, err := syscall.Socket(family, syscall.SOCK_DGRAM, 0)
+	if err != nil {
+		return err
+	}
+	defer syscall.Close(fd)
+	if err = syscall.SetsockoptInt(fd, syscall.SOL_SOCKET, syscall.SO_REUSEADDR, 1); err != nil {
+		return err
+	}
+	if err = syscall.SetsockoptInt(fd, syscall.SOL_IP, syscall.IP_TRANSPARENT, 1); err != nil {
+		return err
+	}
+	if server.Addr().Is4() {
+		return syscall.Bind(fd, &syscall.SockaddrInet4{Addr: server.Addr().As4(), Port: int(server.Port())})
+	}
+	return syscall.Bind(fd, &syscall.SockaddrInet6{Addr: server.Addr().As16(), Port: int(server.Port())})
+}
+func TestRealPortCollisionAndRawReplyDelivery(t *testing.T) {
+	for _, network := range []string{"udp4", "udp6"} {
+		t.Run(network, func(t *testing.T) {
+			_, receiver, server := collisionFixture(t, network)
+			if err := stockBind(server); !errors.Is(err, syscall.EADDRINUSE) {
+				t.Fatalf("stock collision not reproduced: %v", err)
+			}
+			client := receiver.LocalAddr().(*net.UDPAddr).AddrPort()
+			payload := []byte("UDP source tuple and payload must survive collision")
+			n, err := WritePacket(server, client, payload)
+			if err != nil || n != len(payload) {
+				t.Fatalf("raw write n=%d err=%v", n, err)
+			}
+			_ = receiver.SetReadDeadline(time.Now().Add(2 * time.Second))
+			buffer := make([]byte, 1024)
+			n, from, err := receiver.ReadFromUDPAddrPort(buffer)
+			if err != nil || from != server || string(buffer[:n]) != string(payload) {
+				t.Fatalf("wrong reply source=%s n=%d err=%v", from, n, err)
+			}
+		})
+	}
+}
+func TestRawReplyConcurrentClientsAndDescriptorLifetime(t *testing.T) {
+	_, _, server := collisionFixture(t, "udp4")
+	before, _ := os.ReadDir("/proc/self/fd")
+	var group sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		group.Add(1)
+		go func(id int) {
+			defer group.Done()
+			c, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.ParseIP("127.0.0.1")})
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer c.Close()
+			for seq := 0; seq < 32; seq++ {
+				payload := []byte(fmt.Sprintf("client-%d/message-%d", id, seq))
+				if _, err = WritePacket(server, c.LocalAddr().(*net.UDPAddr).AddrPort(), payload); err != nil {
+					t.Error(err)
+					return
+				}
+				_ = c.SetReadDeadline(time.Now().Add(2 * time.Second))
+				buf := make([]byte, 256)
+				n, from, e := c.ReadFromUDPAddrPort(buf)
+				if e != nil || from != server || string(buf[:n]) != string(payload) {
+					t.Errorf("cross-delivered or missing UDP reply: %v", e)
+					return
+				}
+			}
+		}(i)
+	}
+	group.Wait()
+	after, _ := os.ReadDir("/proc/self/fd")
+	if len(after) > len(before)+2 {
+		t.Fatalf("descriptor growth before=%d after=%d", len(before), len(after))
+	}
+}

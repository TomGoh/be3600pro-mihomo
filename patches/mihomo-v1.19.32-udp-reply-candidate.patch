index 0000000..9f6b870
--- /dev/null
+++ b/listener/tproxy/packet_concurrency_test.go
@@ -0,0 +1,56 @@
+package tproxy
+
+import (
+	"net"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/nat"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type failureTunnel struct {
+	C.Tunnel
+	table *nat.Table
+}
+
+func (t failureTunnel) NatTable() C.NatTable { return t.table }
+func TestReplyCreationFailureDoesNotStrandConcurrentWaiters(t *testing.T) {
+	blocker, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4zero})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocker.Close()
+	remote := netip.AddrPortFrom(netip.MustParseAddr("127.0.0.2"), uint16(blocker.LocalAddr().(*net.UDPAddr).Port))
+	local := netip.MustParseAddrPort("127.0.0.1:45321")
+	tunnel := failureTunnel{table: nat.New()}
+	tunnel.table.GetOrCreate(local.String(), func() C.PacketSender { return nil })
+	var group sync.WaitGroup
+	start := make(chan struct{})
+	done := make(chan struct{})
+	for i := 0; i < 32; i++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			<-start
+			for j := 0; j < 100; j++ {
+				conn, e := createOrGetLocalConn(remote, local, tunnel)
+				if conn != nil {
+					conn.Close()
+				}
+				if e == nil {
+					t.Error("expected reply bind failure")
+				}
+			}
+		}()
+	}
+	close(start)
+	go func() { group.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(4 * time.Second):
+		t.Fatal("UDP reply creation failure stranded concurrent waiters")
+	}
+}

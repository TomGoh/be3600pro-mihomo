@@ -0,0 +1,43 @@
+//go:build linux && udp_integration
+
+package tproxy
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/nat"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestWriteBackNonlocalPeer(t *testing.T) {
+	for _, tc := range []struct{ network, env, server string }{{"udp4", "UDP_REPLY_PEER4", "192.0.2.6:27051"}, {"udp6", "UDP_REPLY_PEER6", "[2001:db8:7::9]:27052"}} {
+		t.Run(tc.network, func(t *testing.T) {
+			client, err := netip.ParseAddrPort(os.Getenv(tc.env))
+			if err != nil {
+				t.Fatalf("mandatory isolated peer missing: %s", tc.env)
+			}
+			server := netip.MustParseAddrPort(tc.server)
+			wildcard := net.IPv4zero
+			if tc.network == "udp6" {
+				wildcard = net.IPv6unspecified
+			}
+			blocker, err := net.ListenUDP(tc.network, &net.UDPAddr{IP: wildcard, Port: int(server.Port())})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer blocker.Close()
+			tunnel := failureTunnel{table: nat.New()}
+			tunnel.table.GetOrCreate(client.String(), func() C.PacketSender { return nil })
+			defer tunnel.table.RangeForLocalConn(client.String(), func(_ string, c *net.UDPConn) bool { c.Close(); return true })
+			p := packet{lAddr: client, tunnel: tunnel}
+			payload := []byte("mihomo-nonlocal-" + tc.network + "-proof")
+			n, err := p.WriteBack(payload, net.UDPAddrFromAddrPort(server))
+			if err != nil || n != len(payload) {
+				t.Fatalf("WriteBack nonlocal n=%d err=%v", n, err)
+			}
+		})
+	}
+}
